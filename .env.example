# KronixTax — frontend lead config (no backend). Copy to .env.local and fill in.
# All vars are PUBLIC (NEXT_PUBLIC_*) because they run in the browser.

# WhatsApp office number — digits only, no "+" or spaces. Example: 17124146604
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Inbox that should receive inquiries (used by the EmailJS template)
NEXT_PUBLIC_INQUIRY_EMAIL=info@kronixtax.com

# EmailJS (https://www.emailjs.com) — create a service + template, then paste IDs.
# Template should reference: subject, from_name, from_email, phone, service, message, to_email
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Canonical site URL (optional)
NEXT_PUBLIC_SITE_URL=https://www.kronixtax.com
